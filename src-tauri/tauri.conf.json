  "productName": "FUZZ",
  "version": "1.0.4",
  "identifier": "com.fuzzgame.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FUZZ",
        "width": 480,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
